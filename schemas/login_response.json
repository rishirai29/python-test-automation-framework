{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["token", "user"],
  "properties": {
    "token": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "user": {
      "type": "object",
      "required": ["id", "username"],
      "properties": {"id": {"type": "integer"}, "username": {"type": "string"}}
    }
  }
}
